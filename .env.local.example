# Copy this file to .env.local and fill in real values to connect to live Zoho Books data.
# Leave ZOHO_CLIENT_ID unset (or ZOHO_MOCK_MODE=true) to run the dashboard against
# built-in sample data instead — useful for checking the UI without credentials.

# From Zoho API Console (https://api-console.zoho.com) — create a
# "Server-based Application" (self client), generate a Client ID/Secret,
# and grant the ZohoBooks.fullaccess.all scope (or narrower, once you know
# exactly which read scopes you want) to get a refresh token.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Settings → Organization Profile in Zoho Books.
ZOHO_ORGANIZATION_ID=

# Match these to your account's data center. RPEL's data center should be .in
# (India). See https://www.zoho.com/books/api/v3/introduction/#dc for the
# other regions if that's ever not the case.
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_API_BASE=https://www.zohoapis.in/books/v3

# Set to "true" to force mock/sample data even if the above are filled in.
ZOHO_MOCK_MODE=false
